# ============================================================
# SERVIGO - CLOUD FUNCTIONS
# ============================================================
#
# Para el proyecto Firebase real servigo-dev, copia este archivo como:
#
#   functions/.env.servigo-dev
#
# No agregues credenciales productivas al repositorio.

SERVIGO_ENV=staging
PUSH_ENABLED=false

# URL pública de la aplicación web desplegada en Firebase Hosting.
SERVIGO_WEB_APP_URL=https://servigo-dev.web.app

# Endpoint HTTP que recibe el POST de Transbank y redirige a Angular.
# Está definido como rewrite en firebase.json.
WEBPAY_RETURN_URL=https://servigo-dev.web.app/api/webpay-return

# Ambiente de Webpay: integration para QA / production solo tras certificación.
WEBPAY_MODE=integration

# ServiGo utiliza Webpay Integration durante las pruebas finales.
# Si se omiten, el SDK usa las credenciales públicas de integración definidas
# en el backend. No ingreses credenciales productivas hasta la certificación.
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=
